{
  "name": "clic-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:web": "vite --mode web",
    "build:web": "tsc -b && vite build --mode web",
    "preview:web": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk:debug": "./APK/build-apk.sh debug",
    "android:apk:release": "./APK/build-apk.sh release",
    "android:apk:collect": "cd android && ./gradlew collectApks",
    "android:apk:install": "./APK/install-apk.sh --launch",
    "android:release:protocol": "./scripts/release-android.sh",
    "qa:release-gate": "node ./scripts/qa/apk-release-gate.mjs --stage prebuild",
    "qa:release-promote": "node ./scripts/qa/apk-release-gate.mjs --stage promote",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "nodemon",
    "kds": "python3 server/kds_service.py",
    "db:seed": "node server/seed.js",
    "db:reset": "node server/seed.js && echo 'Base de datos reiniciada correctamente.'",
    "start:dev": "concurrently \"npm run server\" \"npm run dev\" \"npm run kds\"",
    "start:mobile": "USE_HTTPS=true npm run start:dev",
    "start": "npm run start:dev",
    "test:catalog-sync": "tsx --test tests/catalogEditPersistence.test.ts tests/catalogEditQueue.test.ts tests/catalogConflictPermissions.test.ts tests/catalogSnapshotFence.test.ts tests/catalogSnapshotPreservationContract.test.ts tests/catalogMultiTerminalRoundTrip.test.ts tests/catalogLocalChanges.test.ts tests/catalogReleaseFlag.test.ts tests/categoryOptions.test.ts tests/configPushV2Contract.test.ts tests/configPushV2Outbox.test.ts tests/productEditorLayout.test.ts tests/productTaxSnapshot.test.ts tests/taxIdentity.test.ts && node tests/runAutomaticCatalogSaves.mjs",
    "test:erp-sync": "tsx --test tests/erpAlfaRmsContract.test.ts tests/erpBatchCapability.test.ts tests/syncLegacyEndpointAuth.test.ts tests/durableOutboxBatchSender.test.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^1.35.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/nodemailer": "^7.0.5",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.2",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^0.562.0",
    "nodemailer": "^7.0.12",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.13.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "body-parser": "^2.2.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "json-server": "^0.17.4",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
