# Material de firma: nunca debe versionarse
android/key.properties
android/keys/
*.keystore
*.jks

# Entregables APK generados por APK/build-apk.sh, gradlew o scripts/release-android.sh
APK/*.apk
APK/*.sha256
APK/*.json
APK/*.txt
APK/logs/
APK/unsigned/

# Large config and data files
config.json
items.json
ticket_details.txt
clic_pos.db

